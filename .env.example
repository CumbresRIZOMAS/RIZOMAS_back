NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jbrslictkcyjwlvzabxo.supabase.co:5432/postgres
# For Render/serverless deployments use Supabase Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgpodrias hacer la conexion con cloudfareR2 a partir de la imagen y el API que te paso por favor, actualiza el .env por favorres.jbrslictkcyjwlvzabxo:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Optional legacy HS256 validation. Leave unset when using SUPABASE_JWKS_URL.
# SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWKS_URL=https://jbrslictkcyjwlvzabxo.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://jbrslictkcyjwlvzabxo.supabase.co


# Shared secret from Supabase Authentication > Hooks; required for HTTPS hooks.
SUPABASE_AUTH_HOOK_SECRET=replace-with-auth-hook-secret
# Optional OAuth Server endpoints; not required for normal Supabase Auth JWTs.
# SUPABASE_OAUTH_AUTHORIZE_URL=https://jbrslictkcyjwlvzabxo.supabase.co/auth/v1/oauth/authorize
# SUPABASE_OAUTH_TOKEN_URL=https://jbrslictkcyjwlvzabxo.supabase.co/auth/v1/oauth/token
# SUPABASE_OAUTH_DISCOVERY_URL=https://jbrslictkcyjwlvzabxo.supabase.co/auth/v1/.well-known/openid-configuration
CORS_ORIGIN=http://localhost:5173
# Cloudflare R2 (bucket privado; el backend genera URLs prefirmadas GET/PUT/HEAD/DELETE).
# Los valores reales van solo en .env local y en Render, nunca en el repo.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=rizomas-produccion
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=900
GIS_API_URL=https://example.invalid/gis
